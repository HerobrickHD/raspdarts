{
  "manifest_version": 3,
  "name": "Raspdarts",
  "version": "2.0.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://play.autodarts.com/*",
    "http://raspdarts.local:8743/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://play.autodarts.com/*"],
      "js": ["forward.js", "page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://play.autodarts.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://play.autodarts.com/*"],
      "js": ["texts.js", "view-model.js", "page.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["page.html", "page.css", "icons/*"],
      "matches": ["https://play.autodarts.com/*"]
    }
  ]
}
