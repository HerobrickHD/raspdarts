# Kopiere diese Datei nach .env und trage deine Client-ID ein.
# .env ist in .gitignore und wird nie eingecheckt.

# Von Autodarts vergebene Client-ID.
# Autodarts hat die Anmeldung auf OAuth 2.0 umgestellt; der frueher genutzte
# Passwort-Login wurde gestrichen. Eine eigene Client-ID bekommst du auf
# Anfrage - siehe README, Abschnitt "Anmeldung".
# Ein Passwort wird hier NICHT mehr hinterlegt: die Freigabe laeuft einmalig
# ueber einen Code im Browser.
AUTODARTS_CLIENT_ID=

# Board-ID findest du auf autodarts.com unter Boards in der URL,
# oder per `npm run discover` - das Tool listet deine Boards auf.
AUTODARTS_BOARD_ID=

# Port, auf dem die Beamer-Anzeige ausgeliefert wird
PORT=8080
