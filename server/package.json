{
  "name": "autodarts-beamer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Projiziert den Autodarts-Spielstand per Beamer neben die Dartscheibe",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "discover": "tsx src/discover.ts",
    "record": "tsx src/discover.ts --quiet",
    "replay": "tsx src/replay.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^8.0.4",
    "@fastify/websocket": "^11.0.2",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
